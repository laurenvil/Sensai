+#ifdef GGML_VULKAN_SENSAI_TRIM
+// Sensai (Adreno 702): emit zero-byte stubs for matmul variants we won't run.
+// Symbols still resolve (linkage works), but the runtime spv_size==0 check in
+// ggml_vk_create_pipeline_func skips pipeline creation. Host code marks these
+// types as unavailable so supports_op falls back to CPU.
+//
+// Keep on GPU: src0 ∈ {f32, f16, bf16, q4_0, q6_k}, F32 acc only, no MoE
+// (matmul_id, matmul_id_subgroup), no coopmat. bf16 stays because host code
+// references it inside coopmat-gated blocks (still inert at runtime on Adreno).
+static bool sensai_should_stub(const std::string& name) {
+    // Coopmat hardware not present on Adreno 702.
+    if (name.find("_cm1") != std::string::npos) return true;
+    if (name.find("_cm2") != std::string::npos) return true;
+    // F16 accumulators not used on Adreno (F32 path only).
+    if (name.find("_f16acc") != std::string::npos) return true;
+    // MoE / matmul_id (Qwen3.5 has no MoE).
+    if (name.rfind("matmul_id_", 0) == 0) return true;
+    // Per-type filter: only act on plain matmul shaders, not other ops that
+    // happen to embed a type name. Tokenize by '_' starting after "matmul_".
+    if (name.rfind("matmul_", 0) != 0) return false;
+    static const std::vector<std::string> keep = {
+        "matmul_f32_", "matmul_f16_", "matmul_bf16_", "matmul_q4_0_", "matmul_q6_k_",
+    };
+    for (const auto& k : keep) {
+        if (name.rfind(k, 0) == 0) return false;
+    }
+    return true;
+}
+#endif
